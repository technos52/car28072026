rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is an admin
    // Users can check if their own UID exists in the admins collection
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Admins collection - users can check if they are admin (read their own document), admins can read/write all
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      // Only admins can create/update/delete admin documents
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Users collection - authenticated users can read all user data (for inquiries, etc.)
    // Users can write their own data, admins can write all
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update, delete: if isOwner(userId) || isAdmin();
      
      // User's cars subcollection - allow authenticated users to read all, owner/admin to write
      match /cars/{carId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow update, delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
      
      // User's shops subcollection - allow authenticated users to read all, owner/admin to write
      match /shops/{shopId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow update, delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
      
      // User's KYC documents subcollection - owner can read/write, admins can read/write all
      match /kyc_documents/{kycId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow update, delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
      
      // User's wishlist subcollection - allow owner to read/write their own wishlist
      match /wishlist/{carId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
      
      // User's notifications subcollection - owner can read/write, any authenticated user can create (for inquiries), admins can read/write all
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
      
      // User's adminMessages subcollection - owner can read/write, admins can read/write all
      match /adminMessages/{messageId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isAdmin();
        allow update, delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }
    
    // Public cars collection - all authenticated users can read, owner/admin can write
    match /cars/{carId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Shops collection (if exists)
    match /shops/{shopId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Admin notifications collection - any authenticated user can create notifications (for inquiries)
    // All authenticated users can read car_inquiry notifications, admins can read/update/delete all
    match /admin_notifications/{notificationId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (isAdmin() || resource.data.type == 'car_inquiry');
      allow update, delete: if isAuthenticated() && isAdmin();
    }
    
    // Carousel images collection - everyone can read (for displaying on home page), only admins can write
    match /carousel_images/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
